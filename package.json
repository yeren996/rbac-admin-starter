{
  "name": "rbac-admin-starter",
  "version": "0.1.0",
  "description": "RBAC Admin Starter based on NestJS, Prisma, PostgreSQL and Vben Admin web-antd.",
  "private": true,
  "keywords": [
    "rbac",
    "nestjs",
    "prisma",
    "postgresql",
    "vben",
    "vue3"
  ],
  "license": "MIT",
  "author": {
    "name": "RBAC Admin Starter"
  },
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "pnpm run build:rbac",
    "build:antd": "pnpm run build:front",
    "build:api": "pnpm run build:backend",
    "build:rbac": "pnpm build:backend && pnpm run build:front",
    "catalog": "pnpx codemod pnpm/catalog",
    "check": "pnpm run check:rbac",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint \"**/*.ts\" \"**/README.md\" --no-progress",
    "check:dep": "vsh check-dep",
    "check:rbac": "pnpm run check:backend && pnpm run check:type",
    "check:type": "turbo run typecheck",
    "clean": "node ./workspace/scripts/clean.mjs",
    "commit": "czg",
    "db:generate": "pnpm -F @rbac/api prisma:generate",
    "db:migrate": "pnpm -F @rbac/api prisma:migrate",
    "db:seed": "pnpm -F @rbac/api prisma:seed",
    "dev": "pnpm dev:rbac",
    "dev:admin": "pnpm run dev:front",
    "dev:antd": "pnpm run dev:front",
    "dev:api": "pnpm run dev:backend",
    "dev:rbac": "concurrently \"pnpm dev:backend\" \"pnpm dev:front\"",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm",
    "prepare": "is-ci || (git rev-parse --is-inside-work-tree >/dev/null 2>&1 && pnpm exec lefthook install || true)",
    "preview": "pnpm -F @vben/web-antd run preview",
    "rbac:init": "pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "test:unit": "vitest run --dom",
    "build:front": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build --filter=@vben/web-antd",
    "build:backend": "pnpm -F @rbac/api build",
    "dev:front": "pnpm -F @vben/web-antd run dev",
    "dev:backend": "pnpm -F @rbac/api start:dev",
    "check:backend": "pnpm -F @rbac/api lint && pnpm -F @rbac/api test"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxfmt-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/turbo-run": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "concurrently": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.4"
}
